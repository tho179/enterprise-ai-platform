# Bật mock cho các module chưa có API (nghỉ phép, phê duyệt, ticket, thông báo).
# Đặt false khi toàn bộ backend đã triển khai đủ endpoint.
VITE_USE_MOCKS=true

# Để trống khi chạy dev qua Vite proxy hoặc production qua nginx.
VITE_API_BASE_URL=

# Tiền tố AI service. Dev: Vite proxy /ai-api -> 127.0.0.1:8001.
VITE_AI_BASE_URL=/ai-api
