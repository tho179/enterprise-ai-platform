# ==========================================
# ENTERPRISE AI PLATFORM - DOCKER CONFIG
# Copy to .env and fill every "required" value:
#   openssl rand -hex 48     (one value per secret)
# ==========================================

# PostgreSQL (required: POSTGRES_PASSWORD)
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=enterprise_ai_db
POSTGRES_PORT=5432

REDIS_PORT=6379

# Qdrant (required: QDRANT_API_KEY)
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# AI Service (required: INTERNAL_API_TOKEN, shared with the backend)
AI_SERVICE_PORT=8001
INTERNAL_API_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# E5 query/passage prefixes are applied in embedding_service.py.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Extra topic rules tuned on the sample documents; see docs/evaluation_graphrag.md.
ANSWER_DOMAIN_RULES=false

# GraphRAG (required: NEO4J_PASSWORD)
NEO4J_PASSWORD=
GRAPH_ENABLED=true
GRAPH_SEARCH_LIMIT=8
GRAPH_RRF_WEIGHT=0.2

# LLM: configure one, otherwise answers are verbatim excerpts.
# 1) Local (Ollama): docker compose --profile local-llm up -d ollama
#    LLM_BASE_URL=http://ollama:11434/v1
#    LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 2) Cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
LLM_VERIFY_ANSWERS=true

# Backend (required: JWT_SECRET)
BACKEND_PORT=8080
JWT_SECRET=
AI_RATE_LIMIT_PER_MINUTE=30

# Frontend: true runs the console on browser mock data only
VITE_USE_MOCKS=false
FRONTEND_PORT=3000
